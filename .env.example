# Copier ce fichier en .env.local et compléter.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=communication-fla-lu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=communication-fla-lu
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=communication-fla-lu.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Compte de service Admin (secret, jamais versionné).
FIREBASE_PROJECT_ID=communication-fla-lu
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Émulateurs locaux (npm run emulators)
# NEXT_PUBLIC_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
