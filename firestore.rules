rules_version = '2';

// Règles du projet communication-fla-lu, indépendant de MyFLA.
// Tout ce qui n'est pas explicitement autorisé ici est refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isActive() {
      return signedIn() && exists(myProfilePath()) && get(myProfilePath()).data.active == true;
    }

    function isManager() {
      return isActive() && get(myProfilePath()).data.role == "manager";
    }

    function isStaff() {
      return isActive() && get(myProfilePath()).data.role in ["manager", "team"];
    }

    // Rôle, accès (active) et e-mail ne sont modifiés que par le serveur (routes /api/users).
    function onlyProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["firstName", "lastName", "avatarUrl"]);
    }

    match /users/{uid} {
      allow read: if isActive();
      allow update: if ((request.auth.uid == uid && isActive()) || isManager()) && onlyProfileFields();
      allow create, delete: if false;
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRubrique() {
      let d = request.resource.data;
      return d.titre is string && d.titre.size() > 0 && d.titre.size() <= 200
        && d.type in ["post", "story", "video", "cp", "newsletter", "article"]
        && d.canaux is list
        && d.rule is map && d.rule.kind in ["weekly", "monthly", "last"] && d.rule.dow is int
        && d.history is list
        && d.active is bool;
    }

    function validPublication() {
      let d = request.resource.data;
      return d.titre is string && d.titre.size() > 0 && d.titre.size() <= 200
        && isDate(d.date)
        && d.type in ["post", "story", "video", "cp", "newsletter", "article"]
        && d.statut in ["todo", "doing", "review", "scheduled", "done"]
        && d.canaux is list && d.assigneUids is list
        && d.notes is string && d.notes.size() <= 5000
        && d.annulee is bool
        && (d.occurrenceDate == null || isDate(d.occurrenceDate));
    }

    // Rubriques récurrentes : lues par toute l'équipe, gérées par les responsables.
    match /rubriques/{id} {
      allow read: if isStaff();
      allow create, update: if isManager() && validRubrique();
      allow delete: if isManager();
    }

    // Publications ponctuelles et occurrences de rubriques personnalisées (id r_{rubrique}_{date}).
    match /publications/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && validPublication();
      allow delete: if isStaff();
    }

    // Collections à venir (events, tasks, links, partners…) : ajoutées au fil des étapes de la V1.
  }
}
